# Copie este arquivo para .env. Nunca publique nem compartilhe o .env.
PORT=3000
# Nome da conta do TikTok sem @
TIKTOK_USERNAME=

# Provedor de IA: openai | xai | local
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
XAI_API_KEY=
XAI_MODEL=grok-3-mini

# Provedor de voz: browser | fish | chatterbox (local e sem API paga)
TTS_PROVIDER=chatterbox
LOCAL_TTS_PORT=8765
TTS_REFERENCE_AUDIO=voice-reference.wav
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=51f868b27c454c5fb03db8b4165ced82
FISH_AUDIO_MODEL=s2.1-pro
ELEVENLABS_API_KEY=
